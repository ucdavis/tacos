@{
    ViewData["Title"] = "Home";
}

<section class="container">
    <div class="flex flex-col gap-4 pb-12">
    <h1 class="m-0 text-4xl text-primary">TA/Reader Calculation App</h1>
    <div class="grid grid-cols-1 gap-8 pb-8 md:gap-12">
        <div class="min-w-0">
            <p class="mt-1 text-lg">Review course data, submit annual requests, and track exception approvals for TA/Reader support.</p>

            <div class="mt-4 flex flex-wrap gap-3">
                <a asp-controller="Requests" asp-action="index" class="btn btn-primary">
                    View Requests
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        <div class="min-w-0 pt-1 text-base leading-relaxed text-base-content">
            <h2 class="m-0 text-xl font-extrabold text-primary">CA&amp;ES TA/Reader Criteria</h2>
            <p class="mt-1 text-lg">
                Criteria for central TA/Reader funding are updated regularly by a committee of CA&amp;ES Faculty.
            </p>
            <p class="mt-2 text-lg">
                Requests for additional TA or Reader support for courses with unusually special circumstances will be considered using the exception request process.
            </p>
            <a class="btn btn-primary mt-4" href="/CAES-TA-Reader-Criteria-Fall-2026.pdf">
                Read the current criteria <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    </div>

    <div class="min-w-0 text-base-content">
        <h2 class="mb-4 text-3xl font-extrabold leading-tight text-primary">Annual Timeline</h2>
        <ol class="grid grid-cols-1 gap-4 md:grid-cols-4">
            <li class="min-w-0 border-t-4 border-secondary pt-4 leading-normal text-base-content/75"><span class="mb-2 block font-extrabold text-primary">March</span> Annual data refresh</li>
            <li class="min-w-0 border-t-4 border-secondary pt-4 leading-normal text-base-content/75"><span class="mb-2 block font-extrabold text-primary">April</span> Departments begin reviewing and entering annual TA/Reader submissions</li>
            <li class="min-w-0 border-t-4 border-secondary pt-4 leading-normal text-base-content/75"><span class="mb-2 block font-extrabold text-primary">August</span> Deadline for departments to review and finalize annual TA/Reader submissions</li>
            <li class="min-w-0 border-t-4 border-secondary pt-4 leading-normal text-base-content/75"><span class="mb-2 block font-extrabold text-primary">September-October</span> Dean's Office plans annual TA/Reader funding allocations</li>
        </ol>

        <p class="mt-7 max-w-4xl text-lg leading-relaxed text-base-content/75">
            Ad-hoc exception requests for changed circumstances may be submitted throughout the year and funded upon approval.
        </p>
    </div>
    </div>
</section>
