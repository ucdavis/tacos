<!DOCTYPE html>
<html data-theme="readable">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - tacos.mvc</title>
    <base href="~/" />

    <environment names="Development">
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" />
        <link rel="stylesheet" href="https://ucdcdn.azureedge.net/public/ucdavis.1.0.7.css" />
    </environment>
    <environment names="Staging,Production">
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.0.6/css/all.css">
        <link rel="stylesheet" href="https://ucdcdn.azureedge.net/public/ucdavis.1.0.7.css" />
    </environment>

    <partial name="_DatatablesStylesPartial" />

    <react-styles />

    @RenderSection("styles", required: false)
</head>
<body class="min-h-screen bg-base-200 text-base-content flex flex-col">
    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    }

    <main class="flex-1">
    <header class="container mb-6">
        <div class="py-2 flex flex-wrap items-center justify-between gap-4">
            <a class="flex gap-4 items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 rounded-md" asp-action="index" asp-controller="home">
                <img class="h-10 w-auto" src="taco.svg" alt="TA Calculated Outcomes System" />
                <div>
                    <h1 class="text-xl font-extrabold">TACOS</h1>
                    <p class="text-sm text-base-content/70">CA&amp;ES TA/Reader funding request system</p>
                </div>
            </a>

            <button class="btn btn-ghost btn-square lg:hidden" type="button" data-tacos-collapse-target="#siteNavigation" aria-controls="siteNavigation" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>

            <div id="siteNavigation" class="hidden w-full flex-col gap-4 border-t border-base-300 pt-3 lg:flex lg:w-auto lg:flex-row lg:items-center lg:border-0 lg:pt-0">
                <nav aria-label="Primary navigation">
                    <ul class="flex flex-col gap-1 p-0 lg:flex-row lg:items-center">
                        <li>
                            <a class="btn btn-ghost btn-sm justify-start @(currentController == "Requests" ? "btn-active" : "")" asp-controller="Requests" asp-action="index">Requests</a>
                        </li>
                        <li>
                            <a class="btn btn-ghost btn-sm justify-start @(currentController == "Courses" ? "btn-active" : "")" asp-controller="Courses" asp-action="index">Courses</a>
                        </li>
                        <li>
                            <a class="btn btn-ghost btn-sm justify-start @(currentController == "Faqs" ? "btn-active" : "")" asp-controller="Faqs" asp-action="index">FAQ</a>
                        </li>
                        @if (User.IsInRole("Reviewer"))
                        {
                            <li>
                                <a class="btn btn-ghost btn-sm justify-start @(currentController == "Review" ? "btn-active" : "")" asp-controller="review" asp-action="index">Review</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a class="btn btn-ghost btn-sm justify-start @(currentController == "Approval" ? "btn-active" : "")" asp-controller="Approval" asp-action="index">Approvals</a>
                            </li>
                            <li>
                                <a class="btn btn-ghost btn-sm justify-start @(currentController == "System" ? "btn-active" : "")" asp-controller="system" asp-action="Index">Admin</a>
                            </li>
                        }
                    </ul>
                </nav>
                <div class="text-sm text-base-content/70 lg:ml-2">
                    @await Html.PartialAsync("_LoginPartial")
                </div>
            </div>
        </div>
    </header>
        
    @if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"] as string))
    {
        <div class="tacos-page-shell tacos-page-shell--flash">
            <div class="alert alert-error rounded-none shadow-sm">
                <span>@TempData["ErrorMessage"]</span>
                <button type="button" class="btn btn-ghost btn-square btn-sm ml-auto" data-tacos-dismiss="alert" aria-label="Dismiss error message">×</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(TempData["Message"] as string))
    {
        <div class="tacos-page-shell tacos-page-shell--flash">
            <div class="alert alert-info rounded-none shadow-sm">
                <span>@TempData["Message"]</span>
                <button type="button" class="btn btn-ghost btn-square btn-sm ml-auto" data-tacos-dismiss="alert" aria-label="Dismiss message">×</button>
            </div>
        </div>
    }

    <div class="pb-6">
        @RenderBody()
    </div>
    </main>
    
    <environment names="Development">
        <script src="https://code.jquery.com/jquery-3.3.1.js"></script>
    </environment>

    <environment names="Staging,Production">
        <script src="https://code.jquery.com/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous"></script>
    </environment>
    
    <partial name="_DatatablesScriptsPartial" />
    <script src="~/js/tacos-ui.js" asp-append-version="true"></script>

    @RenderSection("scripts", required: false)

    <react-scripts />
</body>
</html>
