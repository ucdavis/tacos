<!DOCTYPE html>
<html data-theme="tacos">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tacos</title>
    <base href="~/" />

    <environment names="Development">
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" />
    </environment>
    <environment names="Staging,Production">
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.0.6/css/all.css">
    </environment>

    <partial name="_DatatablesStylesPartial" />

    <react-styles />

    @RenderSection("styles", required: false)
</head>
<body class="min-h-screen text-base-content flex flex-col">
    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    }

    <main class="flex-1">
    <header class="container">
        <div class="py-3 flex flex-wrap items-center justify-between gap-4 mb-8">
            <a class="flex gap-4 items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 rounded-md" asp-action="index" asp-controller="home">
                <img class="h-10 w-auto" src="taco.svg" alt="TA Calculated Outcomes System" />
                <div>
                    <h1 class="text-xl font-extrabold">TACOS</h1>
                    <p class="text-sm text-base-content/80">Teaching Assistant Calculated Outcome System</p>
                </div>
            </a>

            <button class="btn btn-ghost btn-square lg:hidden" type="button" data-tacos-collapse-target="#siteNavigation" aria-controls="siteNavigation" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>

            <div id="siteNavigation" class="tacos-nav-overlay" data-tacos-offcanvas>
                <button class="tacos-nav-backdrop" type="button" data-tacos-collapse-close="#siteNavigation" aria-label="Close navigation"></button>
                <nav class="tacos-nav-panel" aria-label="Primary navigation">
                    <div class="tacos-nav-mobile-header">
                        <span class="text-sm font-semibold uppercase text-base-content/60">Menu</span>
                        <button class="btn btn-ghost btn-square btn-sm" type="button" data-tacos-collapse-close="#siteNavigation" aria-label="Close navigation">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                    <a class="tacos-nav-link @(currentController == "Requests" ? "tacos-nav-link--active" : "")" asp-controller="Requests" asp-action="index" aria-current="@(currentController == "Requests" ? "page" : null)">Requests</a>
                    <a class="tacos-nav-link @(currentController == "Courses" ? "tacos-nav-link--active" : "")" asp-controller="Courses" asp-action="index" aria-current="@(currentController == "Courses" ? "page" : null)">Courses</a>
                    <a class="tacos-nav-link @(currentController == "Faqs" ? "tacos-nav-link--active" : "")" asp-controller="Faqs" asp-action="index" aria-current="@(currentController == "Faqs" ? "page" : null)">FAQ</a>
                    @if (User.IsInRole("Reviewer"))
                    {
                        <a class="tacos-nav-link @(currentController == "Review" ? "tacos-nav-link--active" : "")" asp-controller="review" asp-action="index" aria-current="@(currentController == "Review" ? "page" : null)">Review</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="tacos-nav-link @(currentController == "Approval" ? "tacos-nav-link--active" : "")" asp-controller="Approval" asp-action="index" aria-current="@(currentController == "Approval" ? "page" : null)">Approvals</a>
                        <a class="tacos-nav-link @(currentController == "System" ? "tacos-nav-link--active" : "")" asp-controller="system" asp-action="Index" aria-current="@(currentController == "System" ? "page" : null)">Admin</a>
                    }
                </nav>
            </div>
        </div>
    </header>
        
    @if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"] as string))
    {
        <div class="container pt-4">
            <div class="alert alert-error rounded-none shadow-sm">
                <span>@TempData["ErrorMessage"]</span>
                <button type="button" class="btn btn-ghost btn-square btn-sm ml-auto" data-tacos-dismiss="alert" aria-label="Dismiss error message">×</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(TempData["Message"] as string))
    {
        <div class="container pt-4">
            <div class="alert alert-info rounded-none shadow-sm">
                <span>@TempData["Message"]</span>
                <button type="button" class="btn btn-ghost btn-square btn-sm ml-auto" data-tacos-dismiss="alert" aria-label="Dismiss message">×</button>
            </div>
        </div>
    }

    <div class="pb-6">
        @RenderBody()
    </div>
    </main>

    <footer class="tacos-circle-footer">
        <div class="tacos-circle-footer__gold" aria-hidden="true">
            <partial name="_GoldCircleSvg" />
        </div>
        <div class="tacos-circle-footer__content">
            <a href="https://caes.ucdavis.edu/" rel="noopener noreferrer" target="_blank">
                <img class="tacos-circle-footer__logo" src="caes.svg" alt="UC Davis College of Agricultural and Environmental Sciences" />
            </a>
            <p class="tacos-circle-footer__credit">
                created by <a href="https://computing.caes.ucdavis.edu/">CRU</a>
            </p>
        </div>
        <div class="tacos-circle-footer__blue" aria-hidden="true">
            <partial name="_BlueCircleSvg" />
        </div>
    </footer>

    <environment names="Development">
        <script src="https://code.jquery.com/jquery-3.3.1.js"></script>
    </environment>

    <environment names="Staging,Production">
        <script src="https://code.jquery.com/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous"></script>
    </environment>
    
    <partial name="_DatatablesScriptsPartial" />
    <script src="~/js/tacos-ui.js" asp-append-version="true"></script>

    @RenderSection("scripts", required: false)

    <react-scripts />
</body>
</html>
